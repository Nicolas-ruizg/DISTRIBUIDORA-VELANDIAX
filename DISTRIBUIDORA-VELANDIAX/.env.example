# Base de datos Supabase/PostgreSQL
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
ENVIO_INTERVALO_SEGUNDOS=30
DB_NAME=postgres
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=TU_PASSWORD

# JWT usado por endpoints administrativos
JWT_SECRET=tu_llave_secreta_muy_segura
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontends autorizados, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Storage para imagenes de productos
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=productos
SUPABASE_STORAGE_KEY=TU_ANON_KEY_O_SERVICE_ROLE_KEY
