# ========================================
# CONFIGURACIÓN DISTRIBUIDORA VELANDIAX
# ========================================

# ========== BASE DE DATOS ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velandiax_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# ========== AUTENTICACIÓN JWT ==========
JWT_SECRET=tu_llave_secreta_muy_segura_aqui_minimo_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== SERVIDOR FASTAPI ==========
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
ENVIRONMENT=production

# ========== WHATSAPP API ==========
WHATSAPP_API_TOKEN=tu_token_de_whatsapp_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_id_cuenta_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_id_aqui

# ========== EMAIL (Notificaciones) ==========
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_app_aqui
EMAIL_FROM=noreply@velandiax.com
EMAIL_ADMIN=admin@velandiax.com

# ========== AWS S3 (Almacenamiento de imágenes) ==========
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_REGION=us-east-1
AWS_S3_BUCKET=velandiax-images

# ========== URLs IMPORTANTES ==========
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
ADMIN_URL=http://localhost:8000/admin

# ========== CONFIGURACIÓN DE LOGS ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========== CONFIGURACIÓN DE IMPUESTOS ==========
IMPUESTO_PORCENTAJE_DEFECTO=19

# ========== LIMITES DE VALIDACIÓN ==========
MAX_PRODUCTOS_POR_VENTA=100
MAX_CANTIDAD_TOTAL_POR_VENTA=10000
