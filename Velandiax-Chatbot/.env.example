# Datos de Meta Developers / WhatsApp > Configuracion de la API
WHATSAPP_TOKEN=pega_aqui_el_token_permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=elige_un_texto_secreto_para_el_webhook
META_APP_SECRET=pega_aqui_el_secreto_de_la_app
GRAPH_API_VERSION=v25.0

# Opcional: numero interno que recibira cada pedido, con indicativo de pais.
# Ejemplo Colombia: 573001234567
ADMIN_WHATSAPP_NUMBER=

# Ruta modificable si luego el catalogo viene de una base de datos.
PRODUCTS_FILE=data/products.json
ORDERS_FILE=data/orders.jsonl

# API existente de Velandiax. Si se configura, el catálogo se carga desde
# GET /productos y el seguimiento desde GET /pedidos/seguimiento.
BACKEND_API_URL=https://api.tu-dominio.com

# Cuenta con rol VENDEDOR o ADMINISTRADOR. Solo se usa en el servidor.
BACKEND_API_EMAIL=
BACKEND_API_PASSWORD=

# Activa después de configurar una cuenta VENDEDOR o ADMINISTRADOR. Replica el
# flujo web actual: pedido PENDIENTE con estado_pago=CANCELADO hasta coordinar pago.
BACKEND_CREATE_ORDERS=false

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
STORE_URL=https://velandiax.com.co
VOLUME_MIN_QUANTITY=50
